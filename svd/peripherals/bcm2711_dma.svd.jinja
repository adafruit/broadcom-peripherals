                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>LITE</name>
                            <description>DMA Lite</description>
                            <bitOffset>28</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                {% else %}
                <register>
                    <name>TI_{{ idx }}</name>
                    <description>DMA Lite Transfer Information</description>
                    <addressOffset>{{ "0x%x" | format(idx * 256 + 8) }}</addressOffset>
