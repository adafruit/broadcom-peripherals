                        </field>
                        <field>
                            <name>WAITS</name>
                            <description>Add Wait Cycles</description>
                            <bitOffset>21</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TXFR_LEN_{{ idx }}</name>
                    <description>DMA Lite Transfer Length</description>
                    <addressOffset>{{ "0x%x" | format(idx * 256 + 20) }}</addressOffset>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>XLENTH</name>
                            <description>Transfer Length</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>DEBUG_{{ idx }}</name>
                    <description>DMA4 Debug register</description>
