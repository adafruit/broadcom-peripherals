                        <field>
                            <name>DMA_STATE</name>
                            <description>DMA State Machine State</description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>9</bitWidth>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>VERSION</name>
                            <description>DMA Version</description>
                            <bitOffset>25</bitOffset>
