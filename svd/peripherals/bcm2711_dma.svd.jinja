                                will
                                access
                                when
                                addressing the 1G uncached range C000_0000->ffff_ffff</description>
                            <bitOffset>28</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                        </field>
                    </fields>
