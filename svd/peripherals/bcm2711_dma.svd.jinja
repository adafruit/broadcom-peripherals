                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        {% endfor %}
                    </fields>
                </register>
                <register>
                    <name>ENABLE</name>
                    <description>Global enable bits for each channel</description>
                    <addressOffset>0xFF0</addressOffset>
                    <resetValue>0x00007FFF</resetValue>
                    <fields>
                        {% for i in range(0, 15) %}
                        <field>
                            <name>EN{{ i }}</name>
                            <description>Enable dma engine {{ i }}</description>
                            <bitOffset>{{ i }}</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        {% endfor %}
                        <field>
                            <name>PAGE</name>
                            <description>Set the 1G SDRAM ram page that the 30-bit DMA engines (DMA0-6) will
