                    </field>
                    <field>
                        <name>SRC_DREQ</name>
                        <description>Control Source Reads with DREQ</description>
                        <bitOffset>10</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>SRC_IGNORE</name>
                        <description>Ignore Reads</description>
                        <bitOffset>11</bitOffset>
                        <bitWidth>1</bitWidth>
