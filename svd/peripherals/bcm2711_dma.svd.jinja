                <register>
                    <name>INT_STATUS</name>
                    <description>Interrupt status of each DMA engine</description>
                    <addressOffset>0xFE0</addressOffset>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        {% for i in range(0, 16) %}
                        <field>
                            <name>INT{{ i }}</name>
                            <description>Interrupt status of DMA engine {{ i }}</description>
