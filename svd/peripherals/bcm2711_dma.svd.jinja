                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>DEST_INC</name>
                            <description>Destination Address Increment</description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
