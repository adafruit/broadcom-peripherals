                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SRC_DREQ</name>
                            <description>Control Source Reads with DREQ</description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>BURST_LENGTH</name>
                            <description>Burst Transfer Length</description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>4</bitWidth>
