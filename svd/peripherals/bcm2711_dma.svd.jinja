{% macro peripheral(base_address) -%}
<peripheral>
    <name>DMA</name>
    <description></description>
    <baseAddress>{{ "0x{:x}".format(base_address) }}</baseAddress>
    <addressBlock>
        <offset>0x0</offset>
        <size>0xFF4</size>
        <usage>registers</usage>
    </addressBlock>
    <registers>
        {% macro dma_channel(idx) %}
        {% if (10 < idx) %} <register>
            <name>CS_{{ idx }}</name>
            <description>DMA4 Control and Status register contains the main control and status bits for this DMA4
                channel</description>
            <addressOffset>{{ "0x%x" | format(idx * 256) }}</addressOffset>
            <resetValue>0x00000008</resetValue>
            <fields>
                <field>
                    <name>ACTIVE</name>
                    <description>Activate the DMA4</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>END</name>
                    <description>End Flag</description>
                    <bitOffset>1</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                    <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                    <name>INT</name>
                    <description>Interrupt Status</description>
                    <bitOffset>2</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                    <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                    <name>DREQ</name>
                    <description>DREQ State</description>
                    <bitOffset>3</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>RD_PAUSED</name>
                    <description>DMA4 Read Paused State</description>
                    <bitOffset>4</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>WR_PAUSED</name>
                    <description>DMA4 Write Paused State</description>
                    <bitOffset>5</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>DREQ_STOPS_DMA</name>
                    <description>DMA4 Paused by DREQ State</description>
                    <bitOffset>6</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>WAITING_FOR_OUTSTANDING_WRITES</name>
                    <description>The DMA4 is Waiting for all the Write Response to be returned</description>
                    <bitOffset>7</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>ERROR</name>
                    <description>DMA4 Error</description>
                    <bitOffset>10</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>QOS</name>
                    <description>AXI QOS Level</description>
                    <bitOffset>16</bitOffset>
                    <bitWidth>4</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>PANIC_QOS</name>
                    <description>AXI Panic QOS Level</description>
                    <bitOffset>20</bitOffset>
                    <bitWidth>4</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>DMA_BUSY</name>
                    <description>Indicates the DMA4 is BUSY</description>
                    <bitOffset>24</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>OUTSTANDING_TRANSACTIONS</name>
                    <description>Indicates that there are outstanding AXI transfers</description>
                    <bitOffset>25</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>WAIT_FOR_OUTSTANDING_WRITES</name>
                    <description>Wait for outstanding writes</description>
                    <bitOffset>28</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>DISDEBUG</name>
                    <description>Disable Debug Pause Signal</description>
                    <bitOffset>29</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>ABORT</name>
                    <description>Abort DMA4</description>
                    <bitOffset>30</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                    <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                    <name>HALT</name>
                    <description>Writing a 1 to this bit will cleanly halt the current DMA4 transfer</description>
                    <bitOffset>31</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                    <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
            </fields>
            </register>
            <register>
                <name>CB_{{ idx }}</name>
                <description>DMA4 Control Block Address register</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 4) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>ADDR</name>
                        <description>Control Block Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>DEBUG_{{ idx }}</name>
                <description>DMA4 Debug register</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 12) }}</addressOffset>
                <resetValue>0x10000400</resetValue>
                <fields>
                    <field>
                        <name>WRITE_ERROR</name>
                        <description>Slave Write Response Error</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>FIFO_ERROR</name>
                        <description>Fifo Error</description>
                        <bitOffset>1</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>READ_ERROR</name>
                        <description>Slave Read Response Error</description>
                        <bitOffset>2</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>READ_CB_ERROR</name>
                        <description>Slave Read Response Error During Control Block Read</description>
                        <bitOffset>3</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>INT_ON_ERROR</name>
                        <description>Generate an interrupt if an error is detected</description>
                        <bitOffset>8</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>HALT_ON_ERROR</name>
                        <description>Instruct the DMA4 to HALT if it detects an error</description>
                        <bitOffset>9</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>ABORT_ON_ERROR</name>
                        <description>Instruct the DMA4 to ABORT if it detects an error</description>
                        <bitOffset>10</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>DISABLE_CLK_GATE</name>
                        <description>Disable the clock gating logic</description>
                        <bitOffset>11</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>R_STATE</name>
                        <description>Read State Machine State</description>
                        <bitOffset>14</bitOffset>
                        <bitWidth>4</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>W_STATE</name>
                        <description>Write State Machine State</description>
                        <bitOffset>18</bitOffset>
                        <bitWidth>4</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>RESET</name>
                        <description>DMA Reset</description>
                        <bitOffset>23</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                        <modifiedWriteValues>oneToClear</modifiedWriteValues>
                    </field>
                    <field>
                        <name>ID</name>
                        <description>ID</description>
                        <bitOffset>24</bitOffset>
                        <bitWidth>4</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>VERSION</name>
                        <description>DMA Version</description>
                        <bitOffset>28</bitOffset>
                        <bitWidth>4</bitWidth>
                        <access>read-only</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>TI_{{ idx }}</name>
                <description>DMA4 Transfer Information</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 16) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>INTEN</name>
                        <description>Interrupt Enable</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>TDMODE</name>
                        <description>Perform a 2D transfer instead of a normal linear transfer</description>
                        <bitOffset>1</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>WAIT_RESP</name>
                        <description>Wait for a Write Response</description>
                        <bitOffset>2</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>WAIT_RD_RESP</name>
                        <description>Wait for a Read Response</description>
                        <bitOffset>3</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>PERMAP</name>
                        <description>Peripheral Mapping</description>
                        <bitOffset>9</bitOffset>
                        <bitWidth>5</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>S_DREQ</name>
                        <description>Control Source Reads with DREQ</description>
                        <bitOffset>14</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>D_DREQ</name>
                        <description>Control Destination Writes with DREQ</description>
                        <bitOffset>15</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>S_WAITS</name>
                        <description>Read Wait Cycles</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>8</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>D_WAITS</name>
                        <description>Write Wait Cycles</description>
                        <bitOffset>24</bitOffset>
                        <bitWidth>8</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>SRC_{{ idx }}</name>
                <description>Lower 32 bits of the DMA4 Source Address</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 20) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>ADDR</name>
                        <description>Lower bits of the Source Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>SRCI_{{ idx }}</name>
                <description>DMA4 Source Information</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 24) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>ADDR</name>
                        <description>High Bits of the Source Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>8</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>BURST_LENGTH</name>
                        <description>Burst Transfer Length</description>
                        <bitOffset>8</bitOffset>
                        <bitWidth>4</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>INC</name>
                        <description>Increment the Source Address</description>
                        <bitOffset>12</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>SIZE</name>
                        <description>Source Transfer Width</description>
                        <bitOffset>13</bitOffset>
                        <bitWidth>2</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>IGNORE</name>
                        <description>Ignore Reads</description>
                        <bitOffset>15</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>STRIDE</name>
                        <description>Source Stride</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>16</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>DEST_{{ idx }}</name>
                <description>Lower 32 bits of the DMA4 Destination Address</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 28) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>ADDR</name>
                        <description>Destination Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>DESTI_{{ idx }}</name>
                <description>DMA4 Destination Information</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 32) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>ADDR</name>
                        <description>High Bits of the Destination Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>8</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>BURST_LENGTH</name>
                        <description>Burst Transfer Length</description>
                        <bitOffset>8</bitOffset>
                        <bitWidth>4</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>INC</name>
                        <description>Increment the Destination Address</description>
                        <bitOffset>12</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>SIZE</name>
                        <description>Destination Transfer Width</description>
                        <bitOffset>13</bitOffset>
                        <bitWidth>2</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>IGNORE</name>
                        <description>Ignore Reads</description>
                        <bitOffset>15</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>STRIDE</name>
                        <description>Destination Stride</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>16</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>LEN_{{ idx }}</name>
                <description>DMA4 Transfer Length</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 36) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>XLENTH</name>
                        <description>Transfer Length in bytes</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>16</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>YLENTH</name>
                        <description>When in 2D mode, This is the Y transfer length, indicating how many xlength
                            transfers are performed, when in normal linear mode this becomes the top bits of the XLENGTH
                        </description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>14</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>NEXT_CB_{{ idx }}</name>
                <description>DMA4 Next Control Block Address</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 40) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>ADDR</name>
                        <description>Address of next CB for chained DMA operations</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>DEBUG2_{{ idx }}</name>
                <description>DMA4 Debug2 register</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 44) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>OUTSTANDING_WRITES</name>
                        <description>Outstanding Write Response Count</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>9</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>OUTSTANDING_READS</name>
                        <description>Outstanding read Words Count</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>9</bitWidth>
                        <access>read-only</access>
                    </field>
                </fields>
            </register>
            {% else %}
            <register>
                <name>CS_{{ idx }}</name>
                <description>DMA Control and Status register contains the main control and status bits for this DMA
                    channel</description>
                <addressOffset>{{ "0x%x" | format(idx * 256) }}</addressOffset>
                <resetValue>0x00000008</resetValue>
                <fields>
                    <field>
                        <name>ACTIVE</name>
                        <description>Activate the DMA</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>END</name>
                        <description>End Flag</description>
                        <bitOffset>1</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                        <modifiedWriteValues>oneToClear</modifiedWriteValues>
                    </field>
                    <field>
                        <name>INT</name>
                        <description>Interrupt Status</description>
                        <bitOffset>2</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                        <modifiedWriteValues>oneToClear</modifiedWriteValues>
                    </field>
                    <field>
                        <name>DREQ</name>
                        <description>DREQ State</description>
                        <bitOffset>3</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>PAUSED</name>
                        <description>DMA Paused State</description>
                        <bitOffset>4</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>DREQ_STOPS_DMA</name>
                        <description>DMA Paused by DREQ State</description>
                        <bitOffset>5</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>WAITING_FOR_OUTSTANDING_WRITES</name>
                        <description>The DMA is Waiting for the Last Write to be Received</description>
                        <bitOffset>6</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>ERROR</name>
                        <description>DMA Error</description>
                        <bitOffset>8</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-only</access>
                    </field>
                    <field>
                        <name>PRIORITY</name>
                        <description>AXI Priority Level</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>4</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>PANIC_PRIORITY</name>
                        <description>AXI Panic Priority Level</description>
                        <bitOffset>20</bitOffset>
                        <bitWidth>4</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>WAIT_FOR_OUTSTANDING_WRITES</name>
                        <description>Wait for outstanding writes</description>
                        <bitOffset>28</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>DISDEBUG</name>
                        <description>Disable Debug Pause Signal</description>
                        <bitOffset>29</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>ABORT</name>
                        <description>Abort DMA</description>
                        <bitOffset>30</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                        <modifiedWriteValues>oneToClear</modifiedWriteValues>
                    </field>
                    <field>
                        <name>RESET</name>
                        <description>DMA Channel Reset</description>
                        <bitOffset>31</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                        <modifiedWriteValues>oneToClear</modifiedWriteValues>
                    </field>
                </fields>
            </register>
            <register>
                <name>CONBLK_AD_{{ idx }}</name>
                <description>DMA Control Block Address register</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 4) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>SCB_ADDR</name>
                        <description>Control Block Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>SOURCE_AD_{{ idx }}</name>
                <description>DMA Source Address</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 12) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>S_ADDR</name>
                        <description>DMA Source Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>DEST_AD_{{ idx }}</name>
                <description>DMA Destination Address</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 16) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>D_ADDR</name>
                        <description>DMA Destination Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            <register>
                <name>NEXTCONBK_{{ idx }}</name>
                <description>DMA Next Control Block Address</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 28) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>ADDR</name>
                        <description>Address of next CB for chained DMA operations</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>
            {% if (idx < 7) %} <register>
                <name>TI_{{ idx }}</name>
                <description>DMA Transfer Information</description>
                <addressOffset>{{ "0x%x" | format(idx * 256 + 8) }}</addressOffset>
                <resetValue>0x00000000</resetValue>
                <fields>
                    <field>
                        <name>INTEN</name>
                        <description>Interrupt Enable</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>TDMODE</name>
                        <description>2D Mode</description>
                        <bitOffset>1</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>WAIT_RESP</name>
                        <description>Wait for a Write Response</description>
                        <bitOffset>3</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>DEST_INC</name>
                        <description>Destination Address Increment</description>
                        <bitOffset>4</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>DEST_WIDTH</name>
                        <description>Destination Transfer Width</description>
                        <bitOffset>5</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>DEST_DREQ</name>
                        <description>Control Destination Writes with DREQ</description>
                        <bitOffset>6</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>DEST_IGNORE</name>
                        <description>Ignore Writes</description>
                        <bitOffset>7</bitOffset>
                        <bitWidth>1</bitWidth>
                        <access>read-write</access>
                    </field>
                    <field>
                        <name>SRC_INC</name>
                        <description>Source Address Increment</description>
